# Copy this file to .env on YOUR machine and fill it in. Never commit .env or share it.
AGENT_PRIVATE_KEY=0x...your agent wallet private key...
CELO_RPC_URL=https://forno.celo.org
# Filled in after you deploy the vault:
ARRA_VAULT=0x3da5f9d36d1ae8769a9460a7788a21c8041c7bb3
# Where the ERC-8004 agent card lives (default: agent.json in the GitHub repo)
AGENT_URI=https://raw.githubusercontent.com/phoenix-2203/arra/main/agent.json
# Arra's ERC-8004 Agent ID on Celo (registered 27 Oct 2026, tx 0xc99e653a...)
AGENT_ID=9996
# Optional: free API key from etherscan.io (works for Celoscan) to verify the vault there
CELOSCAN_API_KEY=
